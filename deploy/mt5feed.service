# Wine MT5 -> /opt/nasdaq/mt5_last_candle.json + mt5_warmup_candles.json sidecar
#
# Install (substitute your server Linux user if not 'trader'):
#   sudo cp /opt/nasdaq/deploy/mt5feed.service /etc/systemd/system/mt5feed-nasdaq.service
#   sudo sed -i 's/YOUR_LINUX_USER/'"$USER"'/g' /etc/systemd/system/mt5feed-nasdaq.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now mt5feed-nasdaq
#   journalctl -u mt5feed-nasdaq -f
#
# Prerequisite: the XM MT5 terminal must ALREADY be running and logged in under
# the SAME WINEPREFIX (/home/<user>/.mt5), with US100Cash enabled in Market Watch.

[Unit]
Description=MT5 -> JSON closed M15 candle + warm-up sidecar for Nasdaq (US100Cash)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=YOUR_LINUX_USER
WorkingDirectory=/opt/nasdaq
Environment=WINEPREFIX=/home/YOUR_LINUX_USER/.mt5
Environment=WINEDEBUG=-all
Environment=MT5_FEED_SYMBOL=US100Cash
Environment=MT5_FEED_TIMEFRAME=M15
Environment=MT5_FEED_FILE=Z:/opt/nasdaq/mt5_last_candle.json
Environment=MT5_WARMUP_FILE=Z:/opt/nasdaq/mt5_warmup_candles.json
Environment=MT5_WARMUP_BARS=250
ExecStart=/usr/bin/xvfb-run --auto-servernum /usr/bin/wine C:/Python312/python.exe Z:/opt/nasdaq/tools/mt5_feed.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
